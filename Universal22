			if (v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam")) then
				changedEffects[v] = v.Enabled;
				v.Enabled = false;
			end
		end
	else
		for v, oldValue in pairs(changedEffects) do
			if v.Parent then
				v.Enabled = oldValue;
			end
		end
		table.clear(changedEffects);
	end
end);
