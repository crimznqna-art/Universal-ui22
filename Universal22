	round(input, 7);
	input.FocusLost:Connect(function()
		local n = tonumber(input.Text);
		if n then
			state[key] = math.clamp(n, min, max);
			callback(state[key]);
		end
		input.Text = tostring(state[key]);
	end);
	return input;
