local function stopFly()
	flyOn = false;
	vertical = 0;
	if flyVelocity then
		flyVelocity:Destroy();
		flyVelocity = nil;
	end
	if flyAttachment then
		flyAttachment:Destroy();
		flyAttachment = nil;
	end
	local h = humanoid();
	if h then
		h.PlatformStand = false;
		if (oldAutoRotate ~= nil) then
			h.AutoRotate = oldAutoRotate;
		end
	end
	flyToggle.Text = "FLY: OFF";
	flyToggle.BackgroundColor3 = C.red;
end
local function startFly()
	stopFly();
	local r = root();
	local h = humanoid();
	if (not r or not h) then
		return;
	end
	oldAutoRotate = h.AutoRotate;
	h.AutoRotate = true;
	h.PlatformStand = false;
	flyAttachment = make("Attachment", {}, r);
	flyVelocity = make("LinearVelocity", {Attachment0=flyAttachment,RelativeTo=Enum.ActuatorRelativeTo.World,MaxForce=1000000,VectorVelocity=Vector3.zero}, r);
	flyOn = true;
	flyToggle.Text = "FLY: ON";
	flyToggle.BackgroundColor3 = Color3.fromRGB(35, 135, 75);
end
local function holdVertical(button, amount)
	button.InputBegan:Connect(function(input)
		if ((input.UserInputType == Enum.UserInputType.MouseButton1) or (input.UserInputType == Enum.UserInputType.Touch)) then
			vertical = amount;
		end
	end);
	button.InputEnded:Connect(function(input)
		if ((input.UserInputType == Enum.UserInputType.MouseButton1) or (input.UserInputType == Enum.UserInputType.Touch)) then
			if (vertical == amount) then
				vertical = 0;
			end
		end
	end);
end
