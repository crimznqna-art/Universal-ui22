local function toggle(parent, title, description, key, callback)
	local b = card(parent, title, description);
	local status = make("TextLabel", {Size=UDim2.fromOffset(37, 19),Position=UDim2.new(1, -43, 0, 4),BackgroundColor3=C.panel,Text="OFF",TextColor3=C.muted,Font=Enum.Font.GothamBold,TextSize=9}, b);
	round(status, 5);
	local function update()
		status.Text = (state[key] and "ON") or "OFF";
		status.TextColor3 = (state[key] and Color3.fromRGB(255, 90, 110)) or C.muted;
	end
	b.Activated:Connect(function()
		state[key] = not state[key];
		if callback then
			callback(state[key]);
		end
		update();
	end);
	update();
	return update;
end
