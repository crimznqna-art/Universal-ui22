			h = make("Highlight", {Name="CrimsonESP",FillColor=C.red,OutlineColor=C.white,FillTransparency=0.65,OutlineTransparency=0,DepthMode=Enum.HighlightDepthMode.AlwaysOnTop,Adornee=character}, gui);
