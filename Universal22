local function numberInput(parent, title, key, min, max, callback)
	local f = createFrame(title, UDim2.new(1, -5, 0, 62), UDim2.new(), parent, C.card);
	makeLabel(f, title, UDim2.new(0.52, 0, 1, 0), UDim2.fromOffset(9, 0), 12);
