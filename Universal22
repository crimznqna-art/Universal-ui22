local frames = 0;
local elapsed = 0;
local renderConnection = Run.RenderStepped:Connect(function(dt)
	frames = frames + 1;
	elapsed = elapsed + dt;
	if (elapsed >= 1) then
		fpsLabel.Text = "FPS: " .. math.floor((frames / elapsed) + 0.5);
		frames = 0;
		elapsed = 0;
		local ok, ping = pcall(function()
			return player:GetNetworkPing() * 2000;
		end);
		if (ok and ping) then
			pingLabel.Text = "PING: " .. math.floor(ping + 0.5) .. " ms";
		else
			pingLabel.Text = "PING: N/A";
		end
	end
	if (flyOn and flyVelocity and flyVelocity.Parent) then
		local h = humanoid();
		if h then
			local direction = h.MoveDirection;
			flyVelocity.VectorVelocity = (direction * flySpeed) + Vector3.new(0, vertical * flySpeed, 0);
		end
	end
end);
local jumpConnection = UIS.JumpRequest:Connect(function()
	if state.infinite then
		local h = humanoid();
		if h then
			h:ChangeState(Enum.HumanoidStateType.Jumping);
		end
	end
end);
local noclipConnection = Run.Stepped:Connect(function()
	if (state.noclip and player.Character) then
		for _, v in ipairs(player.Character:GetDescendants()) do
			if v:IsA("BasePart") then
				v.CanCollide = false;
			end
		end
	end
end);
